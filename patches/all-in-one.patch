+"""Microduck side-roll task (my-microduck-journal): on a left / right command, tip over sideways, roll one full
+turn about the long axis, get back on the feet. Not an upstream skill (upstream has the forward roll, roulade).
+
+Built on the forward-roll environment (same robot model with full collisions, observations, domain
+randomisation, regularisers and their curricula); only the task terms change — see sideroll.py for the reward
+design and the direction convention (twist vy = +1 left, -1 right; symmetry augmentation teaches both sides).
+"""
+import math
+from dataclasses import replace
+
+from mjlab.envs import ManagerBasedRlEnvCfg
+from mjlab.managers import EventTermCfg, RewardTermCfg
+
+from mjlab_microduck.tasks import sideroll as sr
+from mjlab_microduck.tasks.microduck_roulade_env_cfg import (
+    MicroduckRouladeRlCfg,
+    STAND_Z,
+    TUCK_OVERRIDES,
+    _LEG_JOINTS,
+    make_microduck_roulade_env_cfg,
+)
+
+# A roll takes ~1.5-2 s, the get-up ~1.5 s, plus the tip-over from standing and a settle.
+EPISODE_LENGTH_S = 6.0
+MIDROLL_ANGLE_MIN = math.radians(50.0)    # 90 = on the side, 180 = on the back, 270 = other side
+MIDROLL_ANGLE_MAX = math.radians(300.0)   # past the landing gate's lower edge: dense data on the get-up
+LANDING_GATE_LO = math.radians(260.0)
+LANDING_GATE_HI = math.radians(330.0)
+RISE_GATE_LO = math.radians(180.0)
+RISE_GATE_HI = math.radians(260.0)
+
+_ROULADE_TERMS = ("roulade_progress", "roulade_overspeed", "roulade_head_pivot", "roulade_landing_composite",
+                  "roulade_upright_after_roll", "roulade_height_after_roll", "roulade_landing_sharp",
+                  "roulade_stand_tax", "roulade_rise_velocity", "roulade_sagittal", "roulade_lateral_vel",
+                  "roulade_flatness")
+
+
+def make_microduck_sideroll_env_cfg(play: bool = False) -> ManagerBasedRlEnvCfg:
+    cfg = make_microduck_roulade_env_cfg(play=play)
+    cfg.episode_length_s = EPISODE_LENGTH_S
+    for name in _ROULADE_TERMS:
+        cfg.rewards.pop(name, None)
+
+    gates = {"gate_lo": LANDING_GATE_LO, "gate_hi": LANDING_GATE_HI}
+    cfg.rewards["sideroll_progress"] = RewardTermCfg(
+        func=sr.sideroll_progress, weight=8.0, params={"target_angle": 2 * math.pi, "max_paid_rate": 5.0})
+    cfg.rewards["sideroll_overspeed"] = RewardTermCfg(
+        func=sr.sideroll_overspeed_penalty, weight=-0.1, params={"omega_max": 7.0})
+    cfg.rewards["sideroll_landing_composite"] = RewardTermCfg(
+        func=sr.sideroll_landing_composite, weight=4.0,
+        params={"target_height": STAND_Z, "height_std": 0.04, "upright_std": 0.40, "pose_std": 0.40,
+                "joint_indices": _LEG_JOINTS, **gates})
+    cfg.rewards["sideroll_upright_after_roll"] = RewardTermCfg(
+        func=sr.sideroll_upright_after_roll, weight=1.5, params=dict(gates))
+    cfg.rewards["sideroll_height_after_roll"] = RewardTermCfg(
+        func=sr.sideroll_height_after_roll, weight=1.0, params={"target_height": STAND_Z, "std": 0.04, **gates})
+    cfg.rewards["sideroll_landing_sharp"] = RewardTermCfg(
+        func=sr.sideroll_landing_sharp, weight=2.0,
+        params={"target_height": STAND_Z, "height_std": 0.015, "upright_std": 0.3, **gates})
+    cfg.rewards["sideroll_stand_tax"] = RewardTermCfg(
+        func=sr.sideroll_stand_tax, weight=5.0, params={"target_height": STAND_Z, **gates})
+    cfg.rewards["sideroll_rise_velocity"] = RewardTermCfg(
+        func=sr.sideroll_rise_velocity, weight=0.75,
+        params={"max_height": STAND_Z + 0.01, "gate_lo": RISE_GATE_LO, "gate_hi": RISE_GATE_HI})
+    cfg.rewards["sideroll_plane"] = RewardTermCfg(func=sr.sideroll_plane_penalty, weight=-0.1)
+    cfg.rewards["sideroll_forward_vel"] = RewardTermCfg(func=sr.sideroll_forward_velocity_penalty, weight=-0.5)
+    cfg.rewards["sideroll_plane_tilt"] = RewardTermCfg(func=sr.sideroll_plane_tilt_penalty, weight=-0.5)
+
+    # Direction command in the twist slot (written every step from the episode's direction).
+    cfg.commands["twist"] = sr.RollDirectionCommandCfg(**vars(cfg.commands["twist"]))
+
+    # Spawns: standing start or mid-roll (reverse curriculum); also draws the direction and resets the accumulator.
+    # Appended at the end of the event dict, i.e. after reset_robot_joints (the tuck lerps from the HOME pose).
+    old = cfg.events.pop("set_roulade_state")
+    cfg.events["set_sideroll_state"] = EventTermCfg(
+        func=sr.reset_sideroll_state, mode="reset",
+        params={"standing_prob": 0.5, "midroll_prob": 0.5, "standing_z_min": 0.11, "standing_z_max": 0.12,
+                "standing_tilt_max": math.radians(5.0), "midroll_angle_min": MIDROLL_ANGLE_MIN,
+                "midroll_angle_max": MIDROLL_ANGLE_MAX, "midroll_z_min": 0.05, "midroll_z_max": 0.10,
+                "midroll_omega_range": (0.0, 3.0), "tuck_overrides": TUCK_OVERRIDES, "tuck_factor_range": (0.3, 1.0),
+                "joint_noise_std": old.params.get("joint_noise_std", 0.08)})
+    if "roulade_spawn_mix" in cfg.curriculum:
+        cfg.curriculum["sideroll_spawn_mix"] = cfg.curriculum.pop("roulade_spawn_mix")
+        cfg.curriculum["sideroll_spawn_mix"].params["event_name"] = "set_sideroll_state"
+    return cfg
+
+
+MicroduckSideRollRlCfg = replace(
+    MicroduckRouladeRlCfg, experiment_name="microduck_sideroll", run_name="microduck_sideroll", max_iterations=6000)
