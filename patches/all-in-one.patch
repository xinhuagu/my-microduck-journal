+# ─── my-microduck-journal (MICRODUCK_BODY_WIDE): command-relative standing targets ──────────────
+# The stock stand-up rewards pull toward ONE fixed pose (STAND_Z, vertical). With body-pose commands
+# that is a conflict: every commanded crouch or tilt is taxed by the strongest terms in the stack, and
+# the policy answers 10 deg with 3 deg and -30 mm with -2 mm (measured). These variants move the target
+# with the command: at zero command they are identical to the stock terms (straight stand kept).
+
+
+def _trunk_z_rel(env: ManagerBasedRlEnv, asset: Entity) -> torch.Tensor:
+    return torch.nan_to_num(
+        asset.data.root_link_pos_w[:, 2] - env.scene.terrain.env_origins[:, 2], nan=0.0
+    )
+
+
+def _cmd_tilt_err_sq(env: ManagerBasedRlEnv, asset: Entity, command_name: str) -> torch.Tensor:
+    """|g_b,xy - target(cmd roll, pitch)|^2 — same convention as upright_body_cmd_relative."""
+    quat = asset.data.root_link_quat_w
+    g_b = quat_apply_inverse(quat, asset.data.gravity_vec_w)
+    cmd = env.command_manager.get_command(command_name)
+    roll, pitch = cmd[:, 3], cmd[:, 4]
+    target = torch.stack([torch.sin(pitch), -torch.sin(roll) * torch.cos(pitch)], dim=1)
+    return torch.sum(torch.square(g_b[:, :2] - target), dim=1)
+
+
+def height_target_gaussian_cmd(
+    env: ManagerBasedRlEnv,
+    target_height: float,
+    std: float = 0.02,
+    command_name: str = "body_pose",
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """``height_target_gaussian`` with target = target_height + commanded dz (cmd[2])."""
+    asset: Entity = env.scene[asset_cfg.name]
+    dz = env.command_manager.get_command(command_name)[:, 2]
+    return torch.exp(-((_trunk_z_rel(env, asset) - (target_height + dz)) / std) ** 2)
+
+
+def height_l1_penalty_cmd(
+    env: ManagerBasedRlEnv,
+    target_height: float,
+    command_name: str = "body_pose",
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """``height_l1_penalty`` with target = target_height + commanded dz."""
+    asset: Entity = env.scene[asset_cfg.name]
+    dz = env.command_manager.get_command(command_name)[:, 2]
+    return -torch.abs(_trunk_z_rel(env, asset) - (target_height + dz))
+
+
+def upright_gaussian_at_height_cmd(
+    env: ManagerBasedRlEnv,
+    std: float,
+    height_low: float,
+    height_high: float,
+    command_name: str = "body_pose",
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """``upright_gaussian_at_height`` measured against the commanded roll/pitch; the height gate
+    shifts with the commanded dz. NOTE the error is ~tilt^2 (not tilt^2/2 as in the stock term), so
+    the same sharpness needs std * sqrt(2)."""
+    asset: Entity = env.scene[asset_cfg.name]
+    upright_g = torch.exp(-_cmd_tilt_err_sq(env, asset, command_name) / (std * std))
+    dz = env.command_manager.get_command(command_name)[:, 2]
+    z = _trunk_z_rel(env, asset)
+    t = torch.clamp((z - (height_low + dz)) / max(height_high - height_low, 1e-6), 0.0, 1.0)
+    smooth = t * t * (3.0 - 2.0 * t)
+    return upright_g * smooth
+
+
+def standing_composite_score_cmd(
+    env: ManagerBasedRlEnv,
+    target_height: float,
+    height_std: float,
+    upright_std: float,
+    pose_std: float,
+    joint_indices: list,
+    target_overrides: Optional[dict] = None,
+    command_name: str = "body_pose",
+    pose_std_cmd: float | None = None,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """``standing_composite_score`` with height and upright targets following the body command.
+    The joint-pose factor is still measured against the default stand (a crouch bends the knees),
+    so ``pose_std_cmd`` (if given) widens its std while a z/roll/pitch command is active."""
+    asset: Entity = env.scene[asset_cfg.name]
+    cmd = env.command_manager.get_command(command_name)
+    dz = cmd[:, 2]
+    z = _trunk_z_rel(env, asset)
+    height_score = torch.exp(-((z - (target_height + dz)) / height_std) ** 2)
+    upright_score = torch.exp(-_cmd_tilt_err_sq(env, asset, command_name) / (upright_std * upright_std))
+    target = _servo_default_joint_pos(env, asset).clone()
+    if target_overrides:
+        for idx, val in target_overrides.items():
+            target[:, idx] = val
+    joint_pos = _servo_joint_pos(env, asset)[:, joint_indices]
+    target = target[:, joint_indices]
+    pose_err_sq = ((joint_pos - target) ** 2).mean(dim=-1)
+    if pose_std_cmd is not None:
+        active = (cmd[:, 2:5].abs().amax(dim=1) > 1e-3).to(pose_err_sq.dtype)
+        std_eff = pose_std + (pose_std_cmd - pose_std) * active
+        pose_score = torch.exp(-pose_err_sq / (std_eff * std_eff))
+    else:
+        pose_score = torch.exp(-pose_err_sq / (pose_std * pose_std))
+    return height_score * upright_score * pose_score
+
+
+# ─── my-microduck-journal (MICRODUCK_SPEED): forward-speed fine tracking ────────────────────────────
+def track_lin_vel_x_fine(
+    env: ManagerBasedRlEnv,
+    std: float,
+    command_name: str,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """Forward-speed-only Gaussian, exp(-(vx_cmd - vx)^2 / std^2), ADDED next to the stock
+    track_linear_velocity (std 0.32 m/s, which barely prices a 0.1 m/s shortfall). Same additive pattern as
+    track_yaw_rate_fine: the stock term keeps its far-error gradient, this one prices small errors."""
+    asset: Entity = env.scene[asset_cfg.name]
+    cmd = env.command_manager.get_command(command_name)
+    return torch.exp(-torch.square(cmd[:, 0] - asset.data.root_link_lin_vel_b[:, 0]) / std**2)
